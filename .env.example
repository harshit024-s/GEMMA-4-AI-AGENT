# Gemma 4 AI Agent – Environment Variables
# Copy this file to .env and fill in your values.

# ── Required ──────────────────────────────────────────────────────────────────
# Get a standard AI Studio key (starts with AIzaSy...) from https://aistudio.google.com/apikey
# Or use a Vertex AI Express Mode key (starts with AQ....) with Vertex AI API enabled.
GEMINI_API_KEY=your_api_key_here

# ── Optional ──────────────────────────────────────────────────────────────────
# Supported Gemma 4 models on Gemini API: gemma-4-26b-a4b-it, gemma-4-31b-it
MODEL_NAME=gemma-4-26b-a4b-it
# Set USE_VERTEXAI=auto (default), true (for AQ. Vertex Express keys), or false (for AIzaSy AI Studio keys)
USE_VERTEXAI=auto
HOST=127.0.0.1
PORT=8000
